---
/*
 * Policy page wrapper.
 * NOTE: the policy texts are a starting template, not legal advice.
 * Fill in the placeholders in src/config/site.ts and have them reviewed before launch.
 */
import Base from './Base.astro';
import { SITE } from '../config/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<Base title={`${title} · ${SITE.name}`} description={description}>
  <article class="policy mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <p class="text-sm font-semibold text-brand-dark">{SITE.name}</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-ink">{title}</h1>
    <p class="!mt-3 text-sm !text-slate-400">Last updated: {SITE.policiesUpdated}</p>
    <slot />
  </article>
</Base>
