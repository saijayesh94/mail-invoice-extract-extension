# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` (same folder, repo root) and fill in your values.
#   cp .env.example .env
#
# Every value here is PUBLIC — it is printed on the website (that's what the
# PUBLIC_ prefix means). Never put passwords or secret API keys in this file.
#
# `.env` is git-ignored. When you deploy on Cloudflare Pages, add the same
# variables in: Pages project → Settings → Variables and Secrets (Production).
#
# Any value left empty falls back to a visible placeholder like "[Your Business Legal Name]".
# ─────────────────────────────────────────────────────────────────────────────

# Product name shown in the header, footer, pages and favicon title.
# NOTE: the demo video has the name baked in — re-record it after changing this:
#   pnpm video
PUBLIC_BRAND_NAME=InvoiceSnap

# Your live website address, e.g. https://invoicesnap.com (used for canonical links).
PUBLIC_SITE_URL=

# Dodo Payments checkout link for the $19 product.
# Until this is set, every "Pre-order" button scrolls to the Pricing section instead.
PUBLIC_CHECKOUT_URL=

# Shown in the footer and the Privacy / Terms / Refund pages.
PUBLIC_BUSINESS_LEGAL_NAME=
PUBLIC_CONTACT_EMAIL=
PUBLIC_BUSINESS_ADDRESS=
# City and state for "governing law" in the Terms, e.g. Bengaluru, Karnataka, India
PUBLIC_JURISDICTION=
